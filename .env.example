# EmailJS configuration (https://www.emailjs.com/)
# Copy to .env.local and fill in your credentials.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Sheets Web App URL (Apps Script deploy → Web app)
# Each contact form submission appends a new row. Download as Excel from Google Sheets.
GOOGLE_SHEET_WEBAPP_URL=
